// MongoDB Atlas is the single source of truth. Every user-owned record carries
// a `userId` and every query in src/ filters on it.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(auto()) @map("_id") @db.ObjectId
  email               String    @unique
  name                String?
  image               String?
  emailVerified       DateTime?

  // Resume / portfolio
  cvUrl               String?
  portfolioUrl        String?
  githubUrl           String?   // used in software-house outreach emails
  resumeText          String?   // text extracted from the uploaded CV

  // Parsed profile data (JSON-encoded arrays)
  skills              String?
  experience          String?
  education           String?
  projects            String?
  preferredRoles      String?
  profileParsedAt     DateTime?

  // Preferences (JSON-encoded arrays). Nothing runs automatically until
  // the user has confirmed them (preferencesConfirmedAt).
  jobKeywords         String?
  jobLocations        String?
  preferencesConfirmedAt DateTime?
  autoApplyEnabled    Boolean   @default(false)
  autoApplyMinScore   Int       @default(60)
  autoApplyDailyLimit Int       @default(5)

  lastJobSearchAt     DateTime?
  lastGmailSyncAt     DateTime?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  resumeFiles         ResumeFile[]
  jobs                Job[]
  applications        JobApplication[]
  applicationHistory  ApplicationHistory[]
  sentEmails          SentEmail[]
  emails              JobEmail[]
  notifications       Notification[]
  outreachCompanies   OutreachCompany[]
  apiKeys             UserApiKeys?
}

// The user's own API keys for outreach, AES-256-GCM encrypted with ENCRYPTION_KEY
// (src/lib/crypto.ts). Only the last 4 characters are ever sent to the browser.
model UserApiKeys {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  userId          String   @unique @db.ObjectId
  placesKeyEnc    String?  // Google Places API key
  aiProvider      String   @default("anthropic") // anthropic | gemini
  anthropicKeyEnc String?
  geminiKeyEnc    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Software houses found with Google Places for cold outreach. The email is the
// public contact/careers address found on the company's own website. A draft is
// only sent after the user approved it on /dashboard/outreach.
model OutreachCompany {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  userId        String    @db.ObjectId
  name          String
  website       String
  domain        String    // hostname without "www.", one row per company website
  city          String?
  placeId       String?
  email         String?   // lower-cased
  emailSource   String?   // page on the company website where the email was found
  siteText      String?   // text from the company homepage, used to personalise the draft
  // pending  = found, draft not approved yet   | approved = queued for sending
  // sending  = being sent right now             | sent     = delivered to Gmail
  // failed   = send failed (error says why)     | no_email = website lists no public email
  // skipped  = the user chose not to email this company
  status        String    @default("pending")
  subject       String?
  body          String?
  draftedAt     DateTime?
  approvedAt    DateTime?
  sentAt        DateTime?
  gmailMessageId String?
  error         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, domain])
  @@index([userId, status])
  @@index([userId, email])
  @@index([userId, sentAt])
}

// Uploaded CV binary, kept server-side so it can be attached to application emails.
model ResumeFile {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @db.ObjectId
  fileName    String
  contentType String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Google account + OAuth tokens (server-side only, never sent to the browser).
model Account {
  id                 String  @id @default(auto()) @map("_id") @db.ObjectId
  userId             String  @db.ObjectId
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?
  // Set when the user disconnects Gmail or Google revokes the grant.
  // The row is kept so signing in again re-links to the same user.
  disconnectedAt     DateTime?
  // Result of the last real Gmail API call: ok | api_disabled | scope_missing | null (never called).
  // Lets the UI say *why* Gmail is not working instead of a generic failure.
  gmailStatus        String?
  gmailStatusMessage String?
  gmailCheckedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Job {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @db.ObjectId
  title           String
  company         String
  location        String?
  description     String?
  url             String
  applyEmail      String?   // recruiter/apply email found in the posting, if any
  applyUrl        String?   // where a human applies when there is no application email
  applyMethod     String?   // email | external  (how Boot can legitimately apply)
  applyChannel    String?   // email | greenhouse | lever | ashby | workable | linkedin | ...
  roleCategory    String?   // react_js | flutter_mobile | react_native | node_backend | ...
  technologies    String?   // JSON array of technologies found in the posting
  applyError      String?   // why the last automatic application failed (never hidden)
  applyAttemptedAt DateTime?
  source          String
  salary          String?
  jobType         String?
  seniority       String?
  skills          String?
  matchScore      Float?
  status          String    @default("new") // new, saved, applied, skipped
  foundAt         DateTime  @default(now())
  savedAt         DateTime?
  applied         Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications    JobApplication[]
  emails          JobEmail[]

  @@unique([userId, url])
  @@index([userId])
  @@index([company])
}

model JobApplication {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  jobId          String    @db.ObjectId
  userId         String    @db.ObjectId
  status         String    @default("applied") // applied, interview, assessment, rejected, offer
  appliedAt      DateTime  @default(now())
  applicationUrl String?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  job            Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails         JobEmail[]

  @@unique([userId, jobId])
  @@index([userId])
  @@index([appliedAt])
}

model ApplicationHistory {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @db.ObjectId
  jobId           String?   @db.ObjectId
  jobUrl          String
  company         String
  jobTitle        String
  recipientEmail  String?
  appliedAt       DateTime  @default(now())
  method          String    // "auto", "manual"
  status          String?   // "success", "failed"
  notes           String?
  createdAt       DateTime  @default(now())

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, appliedAt])
  @@index([userId, jobUrl])
}

// Every email Boot sent through the user's own Gmail.
model SentEmail {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @db.ObjectId
  jobId          String?  @db.ObjectId
  applicationId  String?  @db.ObjectId
  gmailMessageId String
  gmailThreadId  String?
  to             String
  subject        String
  body           String
  sentAt         DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sentAt])
  @@index([userId, gmailThreadId])
}

model JobEmail {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  userId          String    @db.ObjectId
  jobId           String?   @db.ObjectId
  applicationId   String?   @db.ObjectId
  gmailMessageId  String
  gmailThreadId   String?
  from            String
  subject         String
  body            String?
  emailType       String    // confirmation, interview, assessment, rejection, offer, other
  status          String?
  isRead          Boolean   @default(false)
  receivedAt      DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  job             Job?            @relation(fields: [jobId], references: [id], onDelete: SetNull)
  application     JobApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@unique([userId, gmailMessageId])
  @@index([userId, receivedAt])
}

model Notification {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  type      String
  title     String
  message   String
  read      Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}
